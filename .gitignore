# 构建产物：能从源码重新生成，不进版本控制
bin/
obj/
*.user
*.suo

# 运行时数据：世界存档、记忆库、日志都是跑出来的，不是写出来的
data/
*.log

# 建模与图像源文件：不能重建，但也不该进 git（git 存二进制大文件是自找麻烦）
*.blend
*.blend1
*.3dm
*.3dm.rhl
*.psd
*.psb
*.clip
*.kra
*.xcf
*.ai
*.fbx
*.obj
*.max
*.mb
*.ma

# 立绘原图与中间件：百炼出的每张原图 3 MB 上下，而且 scripts/pixelize.py 随时能重跑出像素版。
# 进版本控制的是最终那几张（{id}.png、{id}-{expr}.png 一类），不是原料。
assets/portraits/*_0[0-9][0-9].png
assets/portraits/*_0[0-9][0-9]_px.png
assets/portraits/*_0[0-9][0-9]_sprite.png

# Unity：Library 一样能重建，而且动辄十几 G。
# 用 ** 而不是写死一层，因为工程在 unity/<工程名>/ 下，而 Library 在工程里面。
unity/**/Library/
unity/**/Temp/
unity/**/Obj/
unity/**/Build/
unity/**/Builds/
unity/**/Logs/
unity/**/UserSettings/
unity/**/*.csproj
unity/**/*.sln

# 桥的命令与回执：一次性的对话，不该进版本控制
unity/**/.bridge/

# 抓下来的窗口截图：用来核对客户端，不是产物
shots/

# 本地依赖与缓存
node_modules/
.cache/
.nuget/
pnpm-store/
*.nupkg

# 编辑器与工具留下的东西
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.bak
*.bak-*
*.orig

# 本地临时目录：备份、跑一次的日志、临时脚本，都不该进版本控制
.tmp/
